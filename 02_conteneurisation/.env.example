# Copier vers .env puis remplacer les valeurs sensibles.
APP_ENV=dev
APP_PORT=8080
POSTGRES_DB=carehub
POSTGRES_USER=carehub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CAREHUB_IMAGE=carehub-app:local

APP_MEM_LIMIT=256m
APP_CPU_LIMIT=0.50
DB_MEM_LIMIT=512m
DB_CPU_LIMIT=0.50
PROXY_MEM_LIMIT=128m
PROXY_CPU_LIMIT=0.25
